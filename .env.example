# Copy to .env and fill in. Never commit .env.

# ── Required ────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# The bot controls your real browser; everyone else is rejected and the bot
# refuses to start without this. Message the bot once and check the log
# ("Rejected update from user id=...") or ask @userinfobot to find your ID.
ALLOWED_USER_IDS=

# ── Claude auth ─────────────────────────────────────────────────────
# Set one. If both are set, ANTHROPIC_API_KEY is used. If neither is set, the
# local Claude Code login is used. Other credential/provider variables
# (ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_USE_BEDROCK/VERTEX/FOUNDRY) are removed.

# Recommended: an Anthropic API key from https://platform.claude.com/
# (usage is billed to your Anthropic Console account).
ANTHROPIC_API_KEY=

# Optional, for personal use: a Claude subscription token from
# `claude setup-token`. Check Anthropic's terms for your plan first:
# https://code.claude.com/docs/en/legal-and-compliance#authentication-and-credential-use
# CLAUDE_CODE_OAUTH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────

# Path to the Aside CLI (run as `aside mcp`). Default: `aside` on PATH,
# else ~/.local/bin/aside.
# ASIDE_COMMAND=/path/to/aside

# Directory with Aside's builtin skills; the ones the bot uses (1password)
# are copied from here at startup. Default: ~/.aside/u/0/skills/builtin
# ASIDE_SKILLS_DIR=~/.aside/u/0/skills/builtin

# Default model and reasoning effort (low, medium, high, xhigh, max).
# /model and /effort override these at runtime (saved in .state/settings.json).
# HOMETABS_MODEL=claude-sonnet-5-5
# HOMETABS_EFFORT=medium

# Session store. Its directory is the bot's state dir: it also holds
# settings.json, models_cache.json and the built skills plugin.
# STATE_FILE=.state/sessions.json

# Log level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
