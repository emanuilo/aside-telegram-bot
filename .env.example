# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (REQUIRED).
# The bot controls your real browser; everyone else is rejected.
# Message the bot once and check the log ("Rejected update from user id=...")
# or ask @userinfobot to find your ID.
ALLOWED_USER_IDS=

# Long-lived Claude subscription token from `claude setup-token`.
# If empty, the local Claude Code login is used (still subscription billing).
# ANTHROPIC_API_KEY is always ignored/scrubbed: this bot never bills API credits.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides
# ASIDE_COMMAND=/Users/you/.local/bin/aside
# ASIDE_BOT_MODEL=claude-sonnet-5-5
# ASIDE_BOT_EFFORT=medium
# STATE_FILE=.state/sessions.json
# LOG_LEVEL=INFO
